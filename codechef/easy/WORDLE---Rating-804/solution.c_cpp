#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    string s;
	    cin>>s;
	    string T;
	    cin>>T;
	    
	    string m="";
        for(int i=0;i<s.length();i++){
            if(s[i]==T[i]){
                m+="G";
            }else{
                m+="B";
            }
        }
	    
	    cout<<m<<endl;
	    
	}

}
