#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int remainder = 0;

        for (char c : s) {
            remainder = (remainder * 10 + (c - '0')) % 20;
        }

        cout << remainder << endl;
    }

    return 0;
}